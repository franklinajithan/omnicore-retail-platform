generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum MovementType {
  RECEIPT
  SALE
  WASTAGE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  stores    Store[]
  products  Product[]
  suppliers Supplier[]
  orders    PurchaseOrder[]
  movements StockMovement[]
  balances  StockBalance[]
  receipts  GoodsReceipt[]
  users     TenantUser[]
  posSales  PosSale[]
  prices    ProductPrice[]
  zones     PricingZone[]
  promotions Promotion[]
  employees Employee[]
}

model TenantUser {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  userId   String
  role     String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  @@unique([tenantId, userId])
  @@index([tenantId])
}

model Store {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @db.Uuid
  code      String
  name      String
  tenant    Tenant @relation(fields: [tenantId], references: [id])
  balances  StockBalance[]
  movements StockMovement[]
  receipts  GoodsReceipt[]
  posSales  PosSale[]
  prices    ProductPrice[]
  zoneAssignments StoreZoneAssignment[]
  promotionTargets PromotionStoreTarget[]
  employeeAssignments EmployeeStoreAssignment[]
  @@unique([tenantId, code])
  @@unique([id, tenantId])
}

model Product {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @db.Uuid
  sku         String
  name        String
  status      ProductStatus @default(ACTIVE)
  baseUnit    String @default("EACH")
  createdAt   DateTime @default(now())
  tenant      Tenant @relation(fields: [tenantId], references: [id])
  barcodes    ProductBarcode[]
  suppliers   SupplierProduct[]
  balances    StockBalance[]
  movements   StockMovement[]
  orderLines  PurchaseOrderLine[]
  receiptLines GoodsReceiptLine[]
  posLines     PosSaleLine[]
  prices       ProductPrice[]
  promotionProducts PromotionProduct[]
  @@unique([tenantId, sku])
  @@unique([id, tenantId])
}

model ProductBarcode {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  code      String
  product   Product @relation(fields: [productId], references: [id])
  @@unique([productId, code])
  @@index([code])
}

model Supplier {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  code     String
  name     String
  email    String?
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  products SupplierProduct[]
  orders   PurchaseOrder[]
  @@unique([tenantId, code])
  @@unique([id, tenantId])
}

model SupplierProduct {
  id           String @id @default(uuid()) @db.Uuid
  supplierId   String @db.Uuid
  productId    String @db.Uuid
  supplierCode String
  packSize     Decimal @db.Decimal(18, 3)
  cost         Decimal @db.Decimal(18, 4)
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  product      Product @relation(fields: [productId], references: [id])
  @@unique([supplierId, supplierCode])
  @@unique([supplierId, productId])
}

model StockBalance {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @db.Uuid
  storeId   String @db.Uuid
  productId String @db.Uuid
  quantity  Decimal @default(0) @db.Decimal(18, 3)
  tenant    Tenant @relation(fields: [tenantId], references: [id])
  store     Store @relation(fields: [storeId, tenantId], references: [id, tenantId])
  product   Product @relation(fields: [productId, tenantId], references: [id, tenantId])
  @@unique([tenantId, storeId, productId])
}

model StockMovement {
  id             String @id @default(uuid()) @db.Uuid
  tenantId       String @db.Uuid
  storeId        String @db.Uuid
  productId      String @db.Uuid
  type           MovementType
  quantityDelta  Decimal @db.Decimal(18, 3)
  referenceType  String
  referenceId    String
  idempotencyKey String
  createdAt      DateTime @default(now())
  tenant         Tenant @relation(fields: [tenantId], references: [id])
  store          Store @relation(fields: [storeId, tenantId], references: [id, tenantId])
  product        Product @relation(fields: [productId, tenantId], references: [id, tenantId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, storeId, productId, createdAt])
}

model PurchaseOrder {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @db.Uuid
  supplierId String @db.Uuid
  number     String
  status     PurchaseOrderStatus @default(DRAFT)
  createdAt  DateTime @default(now())
  tenant     Tenant @relation(fields: [tenantId], references: [id])
  supplier   Supplier @relation(fields: [supplierId, tenantId], references: [id, tenantId])
  lines      PurchaseOrderLine[]
  receipts   GoodsReceipt[]
  @@unique([tenantId, number])
  @@unique([id, tenantId])
}

model PurchaseOrderLine {
  id              String @id @default(uuid()) @db.Uuid
  orderId         String @db.Uuid
  productId       String @db.Uuid
  orderedQuantity Decimal @db.Decimal(18, 3)
  unitCost        Decimal @db.Decimal(18, 4)
  order           PurchaseOrder @relation(fields: [orderId], references: [id])
  product         Product @relation(fields: [productId], references: [id])
}

model GoodsReceipt {
  id             String @id @default(uuid()) @db.Uuid
  tenantId       String @db.Uuid
  orderId        String @db.Uuid
  storeId        String @db.Uuid
  idempotencyKey String
  createdAt      DateTime @default(now())
  tenant         Tenant @relation(fields: [tenantId], references: [id])
  order          PurchaseOrder @relation(fields: [orderId, tenantId], references: [id, tenantId])
  store          Store @relation(fields: [storeId, tenantId], references: [id, tenantId])
  lines          GoodsReceiptLine[]
  @@unique([tenantId, idempotencyKey])
}

model GoodsReceiptLine {
  id               String @id @default(uuid()) @db.Uuid
  receiptId        String @db.Uuid
  productId        String @db.Uuid
  receivedQuantity Decimal @db.Decimal(18, 3)
  receipt          GoodsReceipt @relation(fields: [receiptId], references: [id])
  product          Product @relation(fields: [productId], references: [id])
}


model PosSale {
  id             String   @id @db.Uuid
  tenantId       String   @db.Uuid
  storeId        String   @db.Uuid
  tillId         String
  cashierId      String
  receiptNo      String
  idempotencyKey String
  total          Decimal  @db.Decimal(18, 2)
  status         String   @default("COMPLETED")
  soldAt         DateTime
  receivedAt     DateTime @default(now())
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  store          Store    @relation(fields: [storeId, tenantId], references: [id, tenantId])
  lines          PosSaleLine[]
  payments       PosPayment[]
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, receiptNo])
  @@index([tenantId, storeId, soldAt])
}

model PosSaleLine {
  id        String  @id @default(uuid()) @db.Uuid
  saleId    String  @db.Uuid
  productId String  @db.Uuid
  itemCode  String
  barcode   String?
  name      String
  quantity  Decimal @db.Decimal(18, 3)
  unitPrice Decimal @db.Decimal(18, 2)
  vatRate   Decimal @db.Decimal(8, 4)
  lineTotal Decimal @db.Decimal(18, 2)
  sale      PosSale @relation(fields: [saleId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
  @@index([saleId])
  @@index([productId])
}

model PosPayment {
  id        String @id @default(uuid()) @db.Uuid
  saleId    String @db.Uuid
  method    String
  amount    Decimal @db.Decimal(18, 2)
  reference String?
  sale      PosSale @relation(fields: [saleId], references: [id])
  @@index([saleId])
}


model ProductPrice {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  storeId       String   @db.Uuid
  productId     String   @db.Uuid
  retailPrice   Decimal  @db.Decimal(18, 2)
  vatRate       Decimal  @db.Decimal(8, 4)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  store         Store    @relation(fields: [storeId, tenantId], references: [id, tenantId])
  product       Product  @relation(fields: [productId, tenantId], references: [id, tenantId])
  @@index([tenantId, storeId, productId, effectiveFrom])
  @@index([tenantId, storeId, effectiveFrom, effectiveTo])
}

enum PromotionStatus {
  DRAFT
  APPROVED
  ACTIVE
  PAUSED
  CANCELLED
}

enum PromotionScope {
  ALL_STORES
  ZONES
  STORES
}

enum PromotionType {
  FIXED_PRICE
  PERCENT_OFF
  AMOUNT_OFF
  MULTIBUY_FIXED_PRICE
}

model PricingZone {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  name String
  code String
  tenant Tenant @relation(fields: [tenantId], references: [id])
  assignments StoreZoneAssignment[]
  targets PromotionZoneTarget[]
  @@unique([tenantId, code])
}

model StoreZoneAssignment {
  id String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid
  zoneId String @db.Uuid
  effectiveFrom DateTime @default(now())
  effectiveTo DateTime?
  store Store @relation(fields: [storeId], references: [id])
  zone PricingZone @relation(fields: [zoneId], references: [id])
  @@index([storeId, effectiveFrom, effectiveTo])
}

model Promotion {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  name String
  status PromotionStatus @default(DRAFT)
  scope PromotionScope
  type PromotionType
  startsAt DateTime
  endsAt DateTime
  priority Int @default(0)
  createdBy String
  approvedBy String?
  approvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  products PromotionProduct[]
  stores PromotionStoreTarget[]
  zones PromotionZoneTarget[]
  audit PromotionAudit[]
  @@index([tenantId, status, startsAt, endsAt])
}

model PromotionProduct {
  id String @id @default(uuid()) @db.Uuid
  promotionId String @db.Uuid
  productId String @db.Uuid
  value Decimal @db.Decimal(18, 4)
  requiredQuantity Int?
  promotion Promotion @relation(fields: [promotionId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  @@unique([promotionId, productId])
}

model PromotionStoreTarget {
  promotionId String @db.Uuid
  storeId String @db.Uuid
  promotion Promotion @relation(fields: [promotionId], references: [id])
  store Store @relation(fields: [storeId], references: [id])
  @@id([promotionId, storeId])
}

model PromotionZoneTarget {
  promotionId String @db.Uuid
  zoneId String @db.Uuid
  promotion Promotion @relation(fields: [promotionId], references: [id])
  zone PricingZone @relation(fields: [zoneId], references: [id])
  @@id([promotionId, zoneId])
}

model PromotionAudit {
  id String @id @default(uuid()) @db.Uuid
  promotionId String @db.Uuid
  actorId String
  action String
  details Json?
  createdAt DateTime @default(now())
  promotion Promotion @relation(fields: [promotionId], references: [id])
  @@index([promotionId, createdAt])
}

enum EmployeeStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

model Employee {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  displayName String
  employeeCode String
  pinHash String
  role String
  status EmployeeStatus @default(ACTIVE)
  failedPinAttempts Int @default(0)
  lockedUntil DateTime?
  pinChangedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id])
  stores EmployeeStoreAssignment[]
  @@unique([tenantId, employeeCode])
  @@index([tenantId, status])
}

model EmployeeStoreAssignment {
  employeeId String @db.Uuid
  storeId String @db.Uuid
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  @@id([employeeId, storeId])
  @@index([storeId])
}
