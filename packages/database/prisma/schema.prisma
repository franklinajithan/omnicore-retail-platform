generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum MovementType {
  RECEIPT
  SALE
  WASTAGE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Tenant {
  id            String          @id @default(uuid()) @db.Uuid
  code          String          @unique
  name          String
  legalName     String?
  tradingName   String?
  status        TenantStatus    @default(ACTIVE)
  countryCode   String          @default("GB")
  currencyCode  String          @default("GBP")
  timezone      String          @default("Europe/London")
  locale        String          @default("en-GB")
  vatNumber     String?
  companyNumber String?
  email         String?
  phone         String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  postcode      String?
  country       String?
  logoUrl       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  archivedAt    DateTime?
  stores        Store[]
  products      Product[]
  suppliers     Supplier[]
  orders        PurchaseOrder[]
  movements     StockMovement[]
  balances      StockBalance[]
  receipts      GoodsReceipt[]
  users         TenantUser[]
  usersV2       User[]
  auditLogs     AuditLog[]
}

model TenantUser {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  userId   String
  role     String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, userId])
  @@index([tenantId])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
}

model User {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @db.Uuid
  authUserId     String?
  firstName      String
  lastName       String
  email          String
  phone          String?
  status         UserStatus            @default(INVITED)
  defaultStoreId String?               @db.Uuid
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  lastLoginAt    DateTime?
  tenant         Tenant                @relation(fields: [tenantId], references: [id])
  defaultStore   Store?                @relation("UserDefaultStore", fields: [defaultStoreId, tenantId], references: [id, tenantId])
  stores         UserStoreAssignment[]
  roles          UserRole[]
  auditLogs      AuditLog[]

  @@unique([tenantId, email])
  @@unique([tenantId, authUserId])
  @@index([tenantId])
  @@index([authUserId])
}

enum RoleType {
  SYSTEM
  CUSTOM
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String?          @db.Uuid
  code        String
  name        String
  description String?
  type        RoleType         @default(CUSTOM)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  module      String
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model UserStoreAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  storeId   String   @db.Uuid
  tenantId  String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([tenantId])
}

enum StoreStatus {
  ACTIVE
  INACTIVE
  OPENING_SOON
  CLOSED
}

enum StoreType {
  SUPERMARKET
  CONVENIENCE
  EXPRESS
  WAREHOUSE
  HEAD_OFFICE
}

model Store {
  id            String                @id @default(uuid()) @db.Uuid
  tenantId      String                @db.Uuid
  code          String
  name          String
  status        StoreStatus           @default(ACTIVE)
  storeType     StoreType?
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  postcode      String?
  country       String?
  phone         String?
  email         String?
  timezone      String?
  openingStatus String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  archivedAt    DateTime?
  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  balances      StockBalance[]
  movements     StockMovement[]
  receipts      GoodsReceipt[]
  userDefaults  User[]                @relation("UserDefaultStore")
  assignments   UserStoreAssignment[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@index([tenantId, status])
}

model Product {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @db.Uuid
  sku          String
  name         String
  status       ProductStatus       @default(ACTIVE)
  baseUnit     String              @default("EACH")
  createdAt    DateTime            @default(now())
  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  barcodes     ProductBarcode[]
  suppliers    SupplierProduct[]
  balances     StockBalance[]
  movements    StockMovement[]
  orderLines   PurchaseOrderLine[]
  receiptLines GoodsReceiptLine[]

  @@unique([tenantId, sku])
  @@unique([id, tenantId])
}

model ProductBarcode {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  code      String
  product   Product @relation(fields: [productId], references: [id])

  @@unique([productId, code])
  @@index([code])
}

model Supplier {
  id       String            @id @default(uuid()) @db.Uuid
  tenantId String            @db.Uuid
  code     String
  name     String
  email    String?
  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  products SupplierProduct[]
  orders   PurchaseOrder[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
}

model SupplierProduct {
  id           String   @id @default(uuid()) @db.Uuid
  supplierId   String   @db.Uuid
  productId    String   @db.Uuid
  supplierCode String
  packSize     Decimal  @db.Decimal(18, 3)
  cost         Decimal  @db.Decimal(18, 4)
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  product      Product  @relation(fields: [productId], references: [id])

  @@unique([supplierId, supplierCode])
  @@unique([supplierId, productId])
}

model StockBalance {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @db.Uuid
  storeId   String  @db.Uuid
  productId String  @db.Uuid
  quantity  Decimal @default(0) @db.Decimal(18, 3)
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  store     Store   @relation(fields: [storeId, tenantId], references: [id, tenantId])
  product   Product @relation(fields: [productId, tenantId], references: [id, tenantId])

  @@unique([tenantId, storeId, productId])
}

model StockMovement {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @db.Uuid
  storeId        String       @db.Uuid
  productId      String       @db.Uuid
  type           MovementType
  quantityDelta  Decimal      @db.Decimal(18, 3)
  referenceType  String
  referenceId    String
  idempotencyKey String
  createdAt      DateTime     @default(now())
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  store          Store        @relation(fields: [storeId, tenantId], references: [id, tenantId])
  product        Product      @relation(fields: [productId, tenantId], references: [id, tenantId])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, storeId, productId, createdAt])
}

model PurchaseOrder {
  id         String              @id @default(uuid()) @db.Uuid
  tenantId   String              @db.Uuid
  supplierId String              @db.Uuid
  number     String
  status     PurchaseOrderStatus @default(DRAFT)
  createdAt  DateTime            @default(now())
  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  supplier   Supplier            @relation(fields: [supplierId, tenantId], references: [id, tenantId])
  lines      PurchaseOrderLine[]
  receipts   GoodsReceipt[]

  @@unique([tenantId, number])
  @@unique([id, tenantId])
}

model PurchaseOrderLine {
  id              String        @id @default(uuid()) @db.Uuid
  orderId         String        @db.Uuid
  productId       String        @db.Uuid
  orderedQuantity Decimal       @db.Decimal(18, 3)
  unitCost        Decimal       @db.Decimal(18, 4)
  order           PurchaseOrder @relation(fields: [orderId], references: [id])
  product         Product       @relation(fields: [productId], references: [id])
}

model GoodsReceipt {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @db.Uuid
  orderId        String             @db.Uuid
  storeId        String             @db.Uuid
  idempotencyKey String
  createdAt      DateTime           @default(now())
  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  order          PurchaseOrder      @relation(fields: [orderId, tenantId], references: [id, tenantId])
  store          Store              @relation(fields: [storeId, tenantId], references: [id, tenantId])
  lines          GoodsReceiptLine[]

  @@unique([tenantId, idempotencyKey])
}

model GoodsReceiptLine {
  id               String       @id @default(uuid()) @db.Uuid
  receiptId        String       @db.Uuid
  productId        String       @db.Uuid
  receivedQuantity Decimal      @db.Decimal(18, 3)
  receipt          GoodsReceipt @relation(fields: [receiptId], references: [id])
  product          Product      @relation(fields: [productId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  storeId    String?  @db.Uuid
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, userId])
}
