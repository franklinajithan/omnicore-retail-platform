{
  "name": "@omnicore/pos",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.electron.json && concurrently \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5174 && electron .\"",
    "build": "tsc -p tsconfig.electron.json && vite build && electron-builder --win nsis",
    "preview": "vite preview",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "electron-store": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "5.4.14",
    "zustand": "latest",
    "better-sqlite3": "^12.4.1"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "9.1.2",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "typescript": "5.7.3",
    "wait-on": "8.0.2",
    "@types/better-sqlite3": "latest",
    "@electron/rebuild": "3.7.2"
  },
  "build": {
    "appId": "com.omnicore.pos",
    "productName": "OmniCore POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "dist/db/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
